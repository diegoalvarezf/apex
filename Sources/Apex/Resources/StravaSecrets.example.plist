<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plantilla de credenciales locales.
  Copia este fichero como "StravaSecrets.plist" (mismo directorio) y rellena tus
  valores reales. StravaSecrets.plist está en .gitignore: nunca se sube al repo.
  - ClientID / ClientSecret: https://www.strava.com/settings/api
  - AnthropicAPIKey: https://console.anthropic.com  (para IA Coach y crear rutinas)
-->
<plist version="1.0">
<dict>
	<key>ClientID</key>
	<string>YOUR_STRAVA_CLIENT_ID</string>
	<key>ClientSecret</key>
	<string>YOUR_STRAVA_CLIENT_SECRET</string>
	<key>AnthropicAPIKey</key>
	<string>YOUR_ANTHROPIC_API_KEY</string>
</dict>
</plist>
