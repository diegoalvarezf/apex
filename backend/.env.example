# Copia este fichero a .env para desarrollo local.
# En Railway estas mismas variables se ponen en Settings → Variables.

# Railway la inyecta sola al añadir un Postgres al proyecto.
DATABASE_URL=postgres://usuario:clave@localhost:5432/apex

# Clave EXCLUSIVA del servidor, distinta de la personal: así se puede revocar sin
# afectar a nada más y su consumo queda separado en la consola de Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Las mismas credenciales que hoy están en StravaSecrets.plist. El secreto vive
# aquí precisamente para que deje de viajar dentro de la app.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Suscripciones: apagadas mientras no haya cuenta de desarrollador de Apple.
SUBSCRIPTIONS_ENABLED=false

# Códigos de Apex Pro que se siembran al arrancar, "código:usos" separados por
# comas (0 usos = sin límite). Vacío = no se siembra ninguno.
PRO_CODES=

# Aviso por correo al canjear un código de Apex Pro. Opcionales: sin ellas el
# canje funciona igual, solo no se envía el aviso.
RESEND_API_KEY=
NOTIFY_EMAIL=

# Techo de gasto diario de la clave, en dólares (por defecto 5).
DAILY_SPEND_LIMIT_USD=5
