{
  "name": "apex-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor intermedio de APEX: custodia las credenciales y aplica las cuotas",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "pro:issue": "tsx src/scripts/issueCodes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.2.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
